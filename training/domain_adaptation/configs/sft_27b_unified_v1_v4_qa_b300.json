{
  "tuner_type": "lora",
  "torch_dtype": "bfloat16",
  "freeze_llm": false,
  "freeze_vit": true,
  "freeze_aligner": false,
  "lora_rank": 64,
  "lora_alpha": 128,
  "lora_dropout": 0.05,
  "target_modules": [
    "all-linear"
  ],
  "merge_lora": false,
  "max_length": 16384,
  "truncation_strategy": "delete",
  "strict": true,
  "packing": true,
  "padding_free": true,
  "enable_channel_loss": true,
  "tensor_model_parallel_size": 2,
  "pipeline_model_parallel_size": 1,
  "context_parallel_size": 1,
  "sequence_parallel": true,
  "micro_batch_size": 1,
  "global_batch_size": 64,
  "num_train_epochs": 1,
  "optimizer": "adam",
  "lr": 1e-05,
  "aligner_lr": 5e-06,
  "min_lr": 1e-06,
  "lr_decay_style": "cosine",
  "lr_warmup_fraction": 0.03,
  "weight_decay": 0.01,
  "clip_grad": 1.0,
  "save_safetensors": true
}
